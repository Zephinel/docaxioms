{
  "name": "docaxioms",
  "version": "0.1.0-alpha.0",
  "description": "A documentation system for software projects, derived from axioms instead of habits.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "docaxioms": "bin/docaxioms.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin/",
    "core/",
    "src/",
    "templates/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --no-warnings --test test/*.test.mjs && node bin/docaxioms.mjs check"
  },
  "license": "MIT",
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "picomatch": "^4.0.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  }
}
